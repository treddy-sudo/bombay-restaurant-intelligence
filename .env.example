DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bombay_restaurant_intelligence
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
APP_OWNER_USERNAME=owner
APP_OWNER_PASSWORD=replace-with-a-strong-password
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-gateway-token
OPENCLAW_BACKEND_BASE_URL=http://127.0.0.1:8080
OPENCLAW_BACKEND_SHARED_SECRET=replace-with-a-long-random-secret
OPENCLAW_BACKEND_TIMEOUT_MS=15000
OPENCLAW_BACKEND_READ_RETRIES=1
OPENCLAW_BACKEND_MAX_REQUESTS_PER_MINUTE=120
OPENCLAW_INBOUND_MEDIA_ROOTS=~/.openclaw/media:~/.openclaw/workspace
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_ROUTER_MODEL=qwen3.5:9b
OLLAMA_TEXT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3.5:9b
OLLAMA_VISION_FALLBACK=gemma4:12b
OLLAMA_REASONING_MODEL=qwen3.5:27b
OLLAMA_RESPONSE_MODEL=qwen3.5:9b
OLLAMA_REQUEST_TIMEOUT_MS=120000
OLLAMA_MAX_RETRIES=1
NORMALIZATION_AUTO_POST_THRESHOLD=0.85
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
