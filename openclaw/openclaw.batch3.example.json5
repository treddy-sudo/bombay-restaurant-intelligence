{
  // Batch 3: local text + image + deterministic spreadsheet orchestration. WhatsApp channel is still intentionally not configured.
  models: {
    providers: {
      ollama: {
        baseUrl: "http://127.0.0.1:11434",
        apiKey: "ollama-local",
        api: "ollama",
        timeoutSeconds: 180,
        models: [
          {
            id: "qwen3.5:9b",
            name: "qwen3.5:9b",
            reasoning: true,
            input: ["text", "image"],
            contextTokens: 65536,
            params: { num_ctx: 65536, thinking: false, keep_alive: "15m" },
          },
          {
            id: "gemma4:12b",
            name: "gemma4:12b",
            reasoning: false,
            input: ["text", "image"],
            contextTokens: 32768,
            params: { num_ctx: 32768, keep_alive: "15m" },
          },
          {
            id: "qwen3.5:27b",
            name: "qwen3.5:27b",
            reasoning: true,
            input: ["text"],
            contextTokens: 65536,
            params: { num_ctx: 65536, keep_alive: "15m" },
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      workspace: "./openclaw/workspace",
      model: { primary: "ollama/qwen3.5:9b" },
    },
  },
  tools: {
    allow: [
      "restaurant_route_text",
      "restaurant_ingest_text",
      "restaurant_ingest_image",
      "restaurant_preview_spreadsheet",
      "restaurant_confirm_spreadsheet",
      "restaurant_get_sales",
    ],
  },
  plugins: {
    entries: {
      "bombay-restaurant-tools": {
        enabled: true,
        config: {
          backendBaseUrl: "http://127.0.0.1:8080",
          ollamaBaseUrl: "http://127.0.0.1:11434",
          routerModel: "qwen3.5:9b",
          textModel: "qwen3.5:9b",
          visionModel: "qwen3.5:9b",
          visionFallback: "gemma4:12b",
          responseModel: "qwen3.5:9b",
        },
      },
    },
  },
}
